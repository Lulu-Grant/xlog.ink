# Copy to deploy.env (not committed) and export before scripts/deploy-code.sh
# AUDIT-7 P3-6: no hard-coded production defaults in the script alone.

XLOG_DEPLOY_REMOTE=root@YOUR_HOST
XLOG_DEPLOY_DEST=/www/wwwroot/xlog.ink
XLOG_DEPLOY_KEY=/path/to/private_key

# Optional runtime (server)
# PLAYWRIGHT_MODULE=/opt/xlog-playwright/node_modules/playwright
# PLAYWRIGHT_BROWSERS_PATH=/opt/xlog-playwright-browsers
