<?php
require_once __DIR__ . '/../config.php';

extract(tool_context('{{tool_key}}'));

include __DIR__ . '/../inc/header.php';
?>

<section class="space-y-6">
  <div class="tool-panel">
    <div class="mb-4">
      <h2 class="tool-title-xl"><?= e(trans('{{tool_key}}_section_title')) ?></h2>
      <p class="tool-copy"><?= e(trans('{{tool_key}}_section_hint')) ?></p>
    </div>

    <label class="tool-label">
      <?= e(trans('{{tool_key}}_input_label')) ?>
      <textarea
        id="{{tool_dom_id}}Input"
        class="tool-textarea mt-2 min-h-[18rem]"
        placeholder="<?= e(trans('{{tool_key}}_input_placeholder')) ?>"
        spellcheck="false"
      ></textarea>
    </label>

    <div class="mt-4 flex flex-wrap gap-3">
      <button id="{{tool_dom_id}}PrimaryAction" type="button" class="button">
        <?= e(trans('{{tool_key}}_primary_action')) ?>
      </button>
      <button id="{{tool_dom_id}}SecondaryAction" type="button" class="tool-button-secondary">
        <?= e(trans('{{tool_key}}_secondary_action')) ?>
      </button>
    </div>

    <p id="{{tool_dom_id}}Status" class="tool-status-text mt-4" aria-live="polite">
      <?= e(trans('{{tool_key}}_status_ready')) ?>
    </p>
  </div>

  <div class="tool-panel">
    <div class="mb-4">
      <h2 class="tool-title-xl"><?= e(trans('{{tool_key}}_result_title')) ?></h2>
      <p class="tool-copy"><?= e(trans('{{tool_key}}_result_hint')) ?></p>
    </div>

    <div class="tool-inset-panel rounded-3xl">
      <textarea
        id="{{tool_dom_id}}Output"
        class="tool-output-display"
        rows="4"
        readonly
      ></textarea>
    </div>
  </div>
</section>

<script>
  (function () {
    const input = document.getElementById('{{tool_dom_id}}Input');
    const output = document.getElementById('{{tool_dom_id}}Output');
    const status = document.getElementById('{{tool_dom_id}}Status');
    const primaryAction = document.getElementById('{{tool_dom_id}}PrimaryAction');
    const secondaryAction = document.getElementById('{{tool_dom_id}}SecondaryAction');

    if (!input || !output || !status || !primaryAction || !secondaryAction) {
      return;
    }

    const messages = {
      ready: <?= json_encode(trans('{{tool_key}}_status_ready')) ?>,
      success: <?= json_encode(trans('{{tool_key}}_status_success')) ?>,
      cleared: <?= json_encode(trans('cleared')) ?>,
      empty: <?= json_encode(trans('{{tool_key}}_status_empty')) ?>,
    };

    function setStatus(message) {
      status.textContent = message;
    }

    function runPrimaryAction() {
      const value = input.value.trim();
      if (!value) {
        output.value = '';
        setStatus(messages.empty);
        return;
      }

      output.value = value;
      setStatus(messages.success);
    }

    function clearAll() {
      input.value = '';
      output.value = '';
      setStatus(messages.cleared);
    }

    primaryAction.addEventListener('click', runPrimaryAction);
    secondaryAction.addEventListener('click', clearAll);
  })();
</script>

<?php include __DIR__ . '/../inc/footer.php'; ?>
